# Postgres. Prefer: docker compose up -d
DATABASE_URL=postgresql://dramaforge:dramaforge@localhost:5432/dramaforge

# Session signing. Required in production. NEXTAUTH_SECRET is accepted as an alias.
AUTH_SECRET=replace-with-a-long-random-string

# Demo grants and mock plans. Must be false on a production deployment.
DEMO_MODE=true

# seed | openai_compatible
# With no LLM_API_KEY, the app always uses SeedProvider.
LLM_PROVIDER=seed
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# local | s3  (only local is implemented in this MVP)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.data/storage

# Fixed-tier credit price. Placeholder until you calibrate — see README.
CREDITS_PER_1K_INPUT_CHARS=1500
# Used by the token-cost formula (not the live fixed-tier charge). Keep >= 2.
CREDITS_SAFETY_MARGIN=2

# Optional TTF/OTF that covers CJK, used when exporting PDF.
PDF_FONT_PATH=

# Reserved for a later Creem integration. Unused while billing is a stub.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# S3 adapter is not wired in the demo. Names are reserved.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
